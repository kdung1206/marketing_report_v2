# SMTP Settings for Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=ntkdung1206@gmail.com

# Gemini API Credentials
GEMINI_API_KEY=

# Security Encryption Key
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Supabase (Postgres) — dùng làm database dùng chung, thay cho việc lưu
# src/db_store.json trực tiếp trong repo. Lấy 2 giá trị này tại:
# Supabase Dashboard > Project Settings > API.
#
# QUAN TRỌNG: đây là biến phía SERVER (không có tiền tố VITE_), nên KHÔNG
# bao giờ bị nhúng vào file JS công khai của trình duyệt. Dùng
# SERVICE_ROLE key (không phải anon key) vì server cần toàn quyền đọc/ghi
# và tự quản lý việc phân quyền Admin/Editor/Viewer ở tầng ứng dụng.
# Tuyệt đối không thêm tiền tố VITE_ vào 2 biến này.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Session signing secret (src/server/auth.ts). Used to HMAC-sign the login
# session token issued by POST /api/login. Set this to a long random string
# in .env.local (and in Vercel Environment Variables for production) — anyone
# who knows this value can forge a valid Admin session, so treat it as a
# secret exactly like SUPABASE_SERVICE_ROLE_KEY. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Protects GET /api/cron/weekly-backup (the automated Friday 17:00 ICT
# database backup email — see vercel.json "crons" and
# src/server/backupMailer.ts) from being triggered by anyone who finds the
# URL. Vercel automatically sends `Authorization: Bearer <CRON_SECRET>` on
# its own Cron requests whenever this env var is set on the project — set it
# ONLY in Vercel Environment Variables (production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SMTP settings themselves are configured in-app (Control Panel → Sao Lưu Tự
# Động, Admin-only) and stored encrypted in the database — not via env vars.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# TikTok organic insights (src/server/tiktokSync.ts) — the TikTok half of the
# "Social Report" tab. Requires a TikTok Developer app with the Login Kit
# product added: https://developers.tiktok.com/apps
#
# Setup steps:
#   1. Create an app at developers.tiktok.com/apps (or use an existing one).
#   2. Add the "Login Kit" product to the app.
#   3. Under Login Kit settings, add a Redirect URI — for local dev:
#        http://localhost:3000/api/tiktok/oauth/callback
#      for production, use your real domain instead of localhost:3000. That
#      exact string (scheme+host+path, no trailing slash) is TIKTOK_REDIRECT_URI
#      below — TikTok rejects the callback if it doesn't match exactly.
#   4. Request these scopes for the app: user.info.basic, user.info.stats,
#      video.list. Sandbox/test-user accounts can use them immediately;
#      real accounts need TikTok's App Review to be cleared first — this can
#      take TikTok some time to approve and isn't something this app can
#      shortcut, so kick it off early rather than only right before you need
#      the real connection.
#   5. Copy Client Key / Client Secret from the app's Basic Information page.
#
# Client Key is not secret on its own (it's sent to the browser as part of
# the authorize URL), but Client Secret is — treat it like
# SUPABASE_SERVICE_ROLE_KEY.
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/oauth/callback
