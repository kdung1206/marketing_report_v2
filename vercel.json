{
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/weekly-backup", "schedule": "0 10 * * 5" },
    { "path": "/api/cron/facebook-sync", "schedule": "0 1 * * *" }
  ]
}
