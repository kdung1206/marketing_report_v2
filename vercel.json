{
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/weekly-backup", "schedule": "0 2 * * 2" },
    { "path": "/api/cron/facebook-sync", "schedule": "0 1 * * *" },
    { "path": "/api/cron/weekly-spreadsheet-sync", "schedule": "0 5 * * 1" }
  ]
}
