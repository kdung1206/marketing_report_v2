{
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/weekly-backup", "schedule": "0 10 * * 5" }
  ]
}
